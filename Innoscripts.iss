; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only.

#define MyAppName "InputFlow"
#ifndef MyAppVersion
  #error MyAppVersion is supplied by scripts/package-installer.ps1.
#endif
#define MyAppVersionQuad MyAppVersion + ".0"
#define PayloadDir "InputFlow-" + MyAppVersion + "-install"
#define MyAppPublisher "for-nobody"
#define MyAppURL "https://github.com/for-nobody/input-flow"
#define MyAppExeName "inputflow-agent.exe"
#define DoubleAmp(Value) StringChange(Value, "&", "&&")
#define EscapeConstArgument(Value) StringChange(StringChange(StringChange(Value, "%", "%25"), ",", "%2c"), "}", "%7d")

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{9834A19B-5AB9-469C-9C8A-194A0A6B0581}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={cm:NameAndVersion,{#EscapeConstArgument(MyAppName)},{#EscapeConstArgument(MyAppVersion)}}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
VersionInfoCompany=zhebuilds
VersionInfoProductName=InputFlow Setup
VersionInfoVersion={#MyAppVersionQuad}
VersionInfoDescription=InputFlow {#MyAppVersion} setup
VersionInfoCopyright=Copyright (c) 2026 for-nobody
DefaultDirName={autopf64}\{#MyAppName}
UninstallDisplayIcon={app}\InputFlow.ico
ArchitecturesAllowed=x64os
ArchitecturesInstallIn64BitMode=x64os
SetupArchitecture=x64
MinVersion=10.0.17763
PrivilegesRequired=admin
; The sign-in shortcut is an intentional per-user Startup link. UAC elevation keeps the same user profile.
UsedUserAreasWarning=no
DisableProgramGroupPage=yes
CloseApplications=no
RestartApplications=no
AppMutex=Local\InputFlow.Agent.v1
LicenseFile={#PayloadDir}\LICENSE.txt
OutputDir=inno_setup_output
OutputBaseFilename=InputFlow-{#MyAppVersion}-win-x64-setup
SetupIconFile=installer\InputFlow.ico
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"; InfoBeforeFile: "installer\info-before.en.txt"; InfoAfterFile: "installer\info-after.en.txt"
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"; InfoBeforeFile: "installer\info-before.zh-CN.txt"; InfoAfterFile: "installer\info-after.zh-CN.txt"

[Messages]
english.SetupAppRunningError=InputFlow is still running.%n%nRight-click the notification area icon and choose Exit InputFlow. Then click OK to continue, or Cancel to exit.
chinesesimplified.SetupAppRunningError=InputFlow 仍在运行。%n%n请在通知区域图标上右键并选择 Exit InputFlow，然后单击“确定”继续，或单击“取消”退出。

[CustomMessages]
english.AutoStart=Start InputFlow Agent when I sign in
chinesesimplified.AutoStart=登录时启动 InputFlow Agent

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
Name: "autostart"; Description: "{cm:AutoStart}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#PayloadDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "installer\InputFlow.ico"; DestDir: "{app}"; Flags: ignoreversion
Source: "installer\verify-authenticode.ps1"; Flags: dontcopy
; Uninstall keeps %LOCALAPPDATA%\InputFlow and does not remove the Microsoft runtimes.

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\InputFlow.ico"
Name: "{autoprograms}\InputFlow Settings"; Filename: "{app}\InputFlow.Settings.exe"; WorkingDir: "{app}"; IconFilename: "{app}\InputFlow.ico"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\InputFlow.ico"; Tasks: desktopicon
Name: "{userstartup}\InputFlow Agent"; Filename: "{app}\{#MyAppExeName}"; WorkingDir: "{app}"; IconFilename: "{app}\InputFlow.ico"; Tasks: autostart

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#DoubleAmp(MyAppName)}}"; WorkingDir: "{app}"; Flags: nowait postinstall skipifsilent runasoriginaluser

[Code]
const
  VcUrl = 'https://aka.ms/vs/17/release/vc_redist.x64.exe';
  VcFile = 'vc_redist.x64.exe';
  NetUrl = 'https://builds.dotnet.microsoft.com/dotnet/Runtime/10.0.12/dotnet-runtime-10.0.12-win-x64.exe';
  NetFile = 'dotnet-runtime-10.0.12-win-x64.exe';
  NetSha256 = '02ea072c08f890f9dc0d3ac71b5fd4c2bfcdced4e1133e2d917ce5422b025585';
  WarUrl = 'https://aka.ms/windowsappsdk/2.5/2.5.1/windowsappruntimeinstall-x64.exe';
  WarFile = 'WindowsAppRuntimeInstall-x64.exe';
  WarSha256 = '931a421e8dc3e6e67724806cb67fecdbb88dfe323f0170842eb4a4b4b149f1e2';

var
  DownloadPage: TDownloadWizardPage;
  DependencyRestart: Boolean;

function IsChinese: Boolean;
begin
  Result := ActiveLanguage = 'chinesesimplified';
end;

function TextEnZh(const English, Chinese: String): String;
begin
  if IsChinese then
    Result := Chinese
  else
    Result := English;
end;

function VersionAtLeast(Major, Minor, Bld, NeedMajor, NeedMinor, NeedBld: Cardinal): Boolean;
begin
  Result :=
    (Major > NeedMajor) or
    ((Major = NeedMajor) and ((Minor > NeedMinor) or ((Minor = NeedMinor) and (Bld >= NeedBld))));
end;

function VcRedistOk: Boolean;
var
  Installed, Major, Minor, Bld: Cardinal;
begin
  Result :=
    RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Installed', Installed) and
    (Installed = 1) and
    RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Major', Major) and
    RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Minor', Minor) and
    RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Bld', Bld) and
    VersionAtLeast(Major, Minor, Bld, 14, 44, 35211);
end;

function HasSharedFramework(const Family: String): Boolean;
var
  FindRec: TFindRec;
  Root: String;
begin
  Result := False;
  Root := ExpandConstant('{commonpf64}\dotnet\shared\' + Family);
  if FindFirst(Root + '\10.0.*', FindRec) then
  begin
    try
      repeat
        if (FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY) <> 0 then
        begin
          Result := True;
          Break;
        end;
      until not FindNext(FindRec);
    finally
      FindClose(FindRec);
    end;
  end;
end;

function DotNet10Ok: Boolean;
begin
  Result :=
    HasSharedFramework('Microsoft.NETCore.App') or
    HasSharedFramework('Microsoft.WindowsDesktop.App');
end;

function PowerShellExe: String;
begin
  Result := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
end;

function RunPowerShell(const ScriptName, Arguments: String; var Code: Integer): Boolean;
var
  Params: String;
begin
  Params := '-NoProfile -ExecutionPolicy Bypass -File "' + ExpandConstant('{tmp}\' + ScriptName) + '"';
  if Arguments <> '' then
    Params := Params + ' ' + Arguments;
  Result := Exec(PowerShellExe, Params, '', SW_HIDE, ewWaitUntilTerminated, Code);
end;

function ReadVersionPart(const Name: String; var Index: Integer; var Value: Cardinal): Boolean;
var
  Start: Integer;
begin
  Result := False;
  Value := 0;
  Start := Index;
  while (Index <= Length(Name)) and (Name[Index] >= '0') and (Name[Index] <= '9') do
  begin
    Value := (Value * 10) + (Ord(Name[Index]) - Ord('0'));
    Index := Index + 1;
  end;
  Result := Index > Start;
end;

function RuntimeFolderAccepted(const Name: String): Boolean;
var
  Index: Integer;
  Major, Minor, Patch: Cardinal;
  Marker: String;
begin
  Result := False;
  Marker := 'Microsoft.WindowsAppRuntime.2_';
  if Pos(Marker, Name) <> 1 then
    Exit;
  if Pos('_x64__8wekyb3d8bbwe', Name) = 0 then
    Exit;
  Index := Length(Marker) + 1;
  if not ReadVersionPart(Name, Index, Major) then
    Exit;
  if (Index > Length(Name)) or (Name[Index] <> '.') then
    Exit;
  Index := Index + 1;
  if not ReadVersionPart(Name, Index, Minor) then
    Exit;
  if (Index > Length(Name)) or (Name[Index] <> '.') then
    Exit;
  Index := Index + 1;
  if not ReadVersionPart(Name, Index, Patch) then
    Exit;
  Result := (Major = 2) and (Minor = 5) and (Patch >= 1);
end;

function WinAppRuntimeOk: Boolean;
var
  FindRec: TFindRec;
  Root: String;
begin
  Result := False;
  Root := ExpandConstant('{commonpf64}\WindowsApps');
  if FindFirst(Root + '\Microsoft.WindowsAppRuntime.2_*_x64__8wekyb3d8bbwe', FindRec) then
  begin
    try
      repeat
        if ((FindRec.Attributes and FILE_ATTRIBUTE_DIRECTORY) <> 0) and RuntimeFolderAccepted(FindRec.Name) then
        begin
          Result := True;
          Break;
        end;
      until not FindNext(FindRec);
    finally
      FindClose(FindRec);
    end;
  end;
end;

function MicrosoftSigned(const FileName: String; var Detail: String): Boolean;
var
  Code: Integer;
begin
  if not RunPowerShell('verify-authenticode.ps1', '-Path "' + FileName + '"', Code) then
  begin
    Detail := TextEnZh(
      'Could not check the Microsoft signature.',
      '无法检查 Microsoft 签名。');
    Result := False;
    Exit;
  end;
  Result := Code = 0;
  if not Result then
    Detail := TextEnZh(
      'The downloaded file does not have a valid Microsoft signature.',
      '下载的文件没有有效的 Microsoft 签名。');
end;

function VcInstallerNewEnough(const FileName: String; var Detail: String): Boolean;
var
  VersionMS, VersionLS, Major, Minor, Bld: Cardinal;
begin
  if not GetVersionNumbers(FileName, VersionMS, VersionLS) then
  begin
    Detail := TextEnZh(
      'Could not read the Visual C++ installer version.',
      '无法读取 Visual C++ 安装程序的版本。');
    Result := False;
    Exit;
  end;
  Major := VersionMS shr 16;
  Minor := VersionMS and $FFFF;
  Bld := VersionLS shr 16;
  Result := VersionAtLeast(Major, Minor, Bld, 14, 44, 35211);
  if not Result then
    Detail := TextEnZh(
      'The downloaded Visual C++ installer is older than 14.44.35211.',
      '下载的 Visual C++ 安装程序低于 14.44.35211。');
end;

function InstallerSucceeded(const Code: Integer; AllowAlreadyInstalled: Boolean; var NeedsRestart: Boolean; var Detail: String): Boolean;
begin
  if (Code = 0) or (AllowAlreadyInstalled and (Code = 1638)) then
  begin
    Result := True;
    Exit;
  end;
  if (Code = 3010) or (Code = 1641) then
  begin
    NeedsRestart := True;
    Result := True;
    Exit;
  end;
  Detail := TextEnZh(
    'The Microsoft installer exited with code ' + IntToStr(Code) + '.',
    'Microsoft 安装程序退出代码为 ' + IntToStr(Code) + '。');
  Result := False;
end;

function RunDependency(const FileName, Params: String; AllowAlreadyInstalled: Boolean; var NeedsRestart: Boolean; var Detail: String): Boolean;
var
  Code: Integer;
begin
  if not Exec(FileName, Params, '', SW_SHOWNORMAL, ewWaitUntilTerminated, Code) then
  begin
    Detail := TextEnZh(
      'Could not start the Microsoft installer.',
      '无法启动 Microsoft 安装程序。');
    Result := False;
    Exit;
  end;
  Result := InstallerSucceeded(Code, AllowAlreadyInstalled, NeedsRestart, Detail);
end;

function DependencyInstalled(const Kind: Integer): Boolean;
begin
  case Kind of
    1: Result := VcRedistOk;
    2: Result := DotNet10Ok;
    3: Result := WinAppRuntimeOk;
  else
    Result := False;
  end;
end;

function InstallDownloaded(const DisplayName, BaseName, Params: String; Kind: Integer; VerifyVersion, AllowAlreadyInstalled: Boolean): Boolean;
var
  Downloaded, Detail: String;
  RestartedNow: Boolean;
begin
  Result := False;
  Detail := '';
  RestartedNow := False;
  Downloaded := ExpandConstant('{tmp}\' + BaseName);
  try
    DownloadPage.Msg1Label.Caption := TextEnZh(
      'Checking ' + DisplayName + '...',
      '正在检查 ' + DisplayName + '...');
    DownloadPage.Msg2Label.Caption := TextEnZh(
      'Cancel on this page stops Setup before InputFlow is copied.',
      '此页面上的取消会在复制 InputFlow 之前停止安装。');
    if not MicrosoftSigned(Downloaded, Detail) then
    begin
      SuppressibleMsgBox(Detail, mbCriticalError, MB_OK, IDOK);
      Exit;
    end;
    if VerifyVersion and (not VcInstallerNewEnough(Downloaded, Detail)) then
    begin
      SuppressibleMsgBox(Detail, mbCriticalError, MB_OK, IDOK);
      Exit;
    end;
    DownloadPage.Msg1Label.Caption := TextEnZh(
      'Installing ' + DisplayName + '...',
      '正在安装 ' + DisplayName + '...');
    DownloadPage.Msg2Label.Caption := TextEnZh(
      'The component window has its own Cancel button.',
      '组件窗口有自己的取消按钮。');
    if not RunDependency(Downloaded, Params, AllowAlreadyInstalled, RestartedNow, Detail) then
    begin
      SuppressibleMsgBox(Detail, mbCriticalError, MB_OK, IDOK);
      Exit;
    end;
    if RestartedNow then
      DependencyRestart := True
    else if not DependencyInstalled(Kind) then
    begin
      SuppressibleMsgBox(TextEnZh(
        DisplayName + ' reported success, but it is still not available.',
        DisplayName + ' 报告成功，但系统中仍然不可用。'), mbCriticalError, MB_OK, IDOK);
      Exit;
    end;
    Result := True;
  finally
    DeleteFile(Downloaded);
  end;
end;

function MissingDependencyPrompt(NeedVc, NeedNet, NeedWar: Boolean): Boolean;
var
  Missing: TStringList;
  Prompt: String;
begin
  Missing := TStringList.Create;
  try
    if NeedVc then
      Missing.Add('Microsoft Visual C++ 2015-2022 x64');
    if NeedNet then
      Missing.Add('Microsoft .NET Runtime 10.0.12 x64');
    if NeedWar then
      Missing.Add('Windows App Runtime 2.5.1 x64');
    Prompt := TextEnZh(
      'InputFlow needs these Microsoft components:'#13#10#13#10 + Missing.Text + #13#10 +
      'Setup can download them from Microsoft. Cancel on the download page stops Setup before InputFlow is copied.',
      'InputFlow 需要这些 Microsoft 组件：'#13#10#13#10 + Missing.Text + #13#10 +
      '安装程序可以从 Microsoft 下载它们。下载页面上的取消会在复制 InputFlow 之前停止安装。');
  finally
    Missing.Free;
  end;
  Result := MsgBox(Prompt, mbConfirmation, MB_YESNO) = IDYES;
end;

procedure InitializeWizard;
begin
  DependencyRestart := False;
  DownloadPage := CreateDownloadPage(
    SetupMessage(msgWizardPreparing),
    SetupMessage(msgPreparingDesc),
    nil);
  DownloadPage.ShowBaseNameInsteadOfUrl := True;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  NeedVc, NeedNet, NeedWar: Boolean;
begin
  Result := True;
  if CurPageID <> wpReady then
    Exit;

  NeedVc := not VcRedistOk;
  NeedNet := not DotNet10Ok;
  NeedWar := not WinAppRuntimeOk;
  if (not NeedVc) and (not NeedNet) and (not NeedWar) then
    Exit;

  if not MissingDependencyPrompt(NeedVc, NeedNet, NeedWar) then
  begin
    Result := False;
    Exit;
  end;

  DownloadPage.Clear;
  if NeedVc then
    DownloadPage.Add(VcUrl, VcFile, '');
  if NeedNet then
    DownloadPage.Add(NetUrl, NetFile, NetSha256);
  if NeedWar then
    DownloadPage.Add(WarUrl, WarFile, WarSha256);

  ExtractTemporaryFile('verify-authenticode.ps1');
  DownloadPage.Show;
  try
    try
      DownloadPage.Download;
    except
      Result := False;
      if DownloadPage.AbortedByUser then
        Log('Dependency download cancelled.')
      else
        SuppressibleMsgBox(TextEnZh(
          'Could not download a Microsoft component. ' + GetExceptionMessage + #13#10 +
          'If this computer is offline, connect and try again. InputFlow was not copied.',
          '无法下载 Microsoft 组件。' + GetExceptionMessage + #13#10 +
          '如果这台电脑处于离线状态，请联网后重试。InputFlow 尚未复制。'),
          mbCriticalError, MB_OK, IDOK);
      Exit;
    end;

    if NeedVc then
      Result := InstallDownloaded(
        'Microsoft Visual C++ 2015-2022 x64', VcFile,
        '/install /passive /norestart', 1, True, True);
    if Result and NeedNet then
      Result := InstallDownloaded(
        'Microsoft .NET Runtime 10.0.12 x64', NetFile,
        '/install /passive /norestart', 2, False, True);
    if Result and NeedWar then
      Result := InstallDownloaded(
        'Windows App Runtime 2.5.1 x64', WarFile,
        '', 3, False, False);
  finally
    if not Result then
    begin
      DeleteFile(ExpandConstant('{tmp}\' + VcFile));
      DeleteFile(ExpandConstant('{tmp}\' + NetFile));
      DeleteFile(ExpandConstant('{tmp}\' + WarFile));
    end;
    DownloadPage.Hide;
  end;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  Result := '';
  if DependencyRestart then
    NeedsRestart := True;
end;
