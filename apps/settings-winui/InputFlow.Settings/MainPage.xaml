<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="InputFlow_Settings.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:InputFlow_Settings.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    KeyDown="Page_KeyDown"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="CancelCaptureAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <NavigationView
        x:Name="RootNavigation"
        AutomationProperties.Name="InputFlow 设置导航"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Auto"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="RulesNavigation" Content="快捷规则" IsSelected="True" Tag="rules">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="设置" Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="关于" Tag="about">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid Padding="20,12,20,20" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                x:Name="ConnectionBar"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="正在连接">
                <InfoBar.ActionButton><Button Click="RetryConnection_Click" Content="重试" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="CaptureBar"
                Grid.Row="1"
                AutomationProperties.LiveSetting="Assertive"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational"
                Title="正在录制输入">
                <InfoBar.ActionButton><Button Click="CancelCapture_Click" Content="取消 (Esc)" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="OperationBar"
                Grid.Row="2"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="True"
                IsOpen="False" />

            <Grid x:Name="RulesPage" Grid.Row="3" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="快捷规则" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前支持四种触发条件和键盘组合动作；修改先进入本地草稿。" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="DirtyText" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="有未保存更改" Visibility="Collapsed" />
                </Grid>
                <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
                    <AppBarButton AutomationProperties.Name="新建规则" Click="AddRule_Click" Icon="Add" Label="新建" />
                    <AppBarButton x:Name="SaveButton" AutomationProperties.Name="验证并保存草稿" Click="Save_Click" Icon="Save" Label="验证并保存" />
                    <AppBarButton AutomationProperties.Name="重新加载正式配置" Click="Reload_Click" Icon="Refresh" Label="重新加载" />
                    <AppBarSeparator />
                    <AppBarButton x:Name="PauseButton" AutomationProperties.Name="暂停或恢复 Agent" Click="PauseResume_Click" Icon="Pause" Label="暂停" />
                    <CommandBar.Content>
                        <ComboBox x:Name="GroupFilter" MinWidth="160" AutomationProperties.Name="按首键筛选规则" SelectionChanged="GroupFilter_SelectionChanged" />
                    </CommandBar.Content>
                </CommandBar>

                <Grid x:Name="RulesWorkspace" Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="EditorColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="RulesListPane">
                        <ListView x:Name="RulesList" AutomationProperties.Name="规则列表" IsItemClickEnabled="False" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleSwitch AutomationProperties.Name="{Binding ToggleAutomationName}" IsOn="{Binding Enabled, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Id}" />
                                                    <Border Padding="6,1" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="9"><TextBlock FontSize="11" Text="{Binding Group}" /></Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TriggerSummary}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ActionSummary}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" AutomationProperties.Name="{Binding EditAutomationName}" Click="EditRule_Click" Content="编辑" Tag="{Binding Id}" />
                                            <Button Grid.Column="3" AutomationProperties.Name="{Binding DeleteAutomationName}" Click="DeleteRule_Click" Content="删除" Tag="{Binding Id}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EmptyRulesText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前分组没有规则。选择“新建”开始。" Visibility="Collapsed" />
                    </Grid>

                    <Border x:Name="RuleEditor" Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                        <ScrollViewer x:Name="RuleEditorScroll" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="EditorTitle" FontSize="20" FontWeight="SemiBold" Text="编辑规则" />
                                <InfoBar x:Name="EditorInfo" IsClosable="False" IsOpen="False" Severity="Error" />
                                <TextBox x:Name="RuleIdBox" AutomationProperties.Name="规则 ID" Header="规则 ID" />
                                <ToggleSwitch x:Name="EditorEnabled" AutomationProperties.Name="规则启用状态" Header="启用规则" OffContent="禁用" OnContent="启用" />
                                <ComboBox x:Name="TriggerTypeCombo" AutomationProperties.Name="触发条件类型" Header="触发条件" SelectionChanged="TriggerTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="键 + 键" Tag="key_chord" />
                                    <ComboBoxItem Content="键 + 鼠标按钮" Tag="key_mouse_button" />
                                    <ComboBoxItem Content="长按键盘键" Tag="hold" />
                                    <ComboBoxItem Content="长按键盘键 + 鼠标按钮" Tag="hold_mouse_button" />
                                </ComboBox>
                                <TextBlock FontWeight="SemiBold" Text="第一个键" />
                                <controls:KeyPicker x:Name="PrimaryKeyPicker" CaptureRequested="KeyPicker_CaptureRequested" />
                                <StackPanel x:Name="SecondKeyPanel" Spacing="6">
                                    <TextBlock FontWeight="SemiBold" Text="第二个键" />
                                    <controls:KeyPicker x:Name="SecondaryKeyPicker" CaptureRequested="KeyPicker_CaptureRequested" />
                                </StackPanel>
                                <StackPanel x:Name="TimeoutPanel" Spacing="6" Visibility="Collapsed">
                                    <NumberBox x:Name="TimeoutBox" AutomationProperties.Name="键盘键长按毫秒数" Header="键盘键长按阈值（毫秒）" Maximum="60000" Minimum="1" SpinButtonPlacementMode="Inline" Value="250" />
                                    <TextBlock x:Name="TimeoutHelpText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="MousePanel" Spacing="6" Visibility="Collapsed">
                                    <TextBlock FontWeight="SemiBold" Text="随后按下的鼠标按钮" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="MouseButtonCombo" AutomationProperties.Name="鼠标按钮" HorizontalAlignment="Stretch" />
                                        <Button x:Name="RecordMouseButtonButton" Grid.Column="1" AutomationProperties.Name="录制鼠标按钮" Click="RecordMouseButton_Click" Content="录制" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="动作：键盘组合" />
                                <StackPanel x:Name="ActionKeysPanel" Spacing="8" />
                                <Button HorizontalAlignment="Left" AutomationProperties.Name="增加动作键" Click="AddActionKey_Click" Content="增加动作键" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="复制/粘贴可分别表达为 Ctrl+C / Ctrl+V。当前没有专用剪贴板动作。" TextWrapping="Wrap" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button Click="CancelEdit_Click" Content="取消编辑" />
                                    <Button Click="CommitEdit_Click" Content="写入草稿" Style="{StaticResource AccentButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="SettingsPage" Grid.Row="3" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="设置与诊断" />
                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="紧急旁路键" />
                            <TextBlock Text="紧急键必须是 logical，并且不能作为启用规则的首键。最终冲突由 Agent 校验。" TextWrapping="Wrap" />
                            <controls:KeyPicker x:Name="EmergencyKeyPicker" CaptureEnabled="False" />
                            <Button HorizontalAlignment="Left" Click="SetEmergencyKey_Click" Content="写入草稿" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Agent 状态" />
                            <TextBlock x:Name="AgentStatusText" Text="未连接" TextWrapping="Wrap" />
                            <TextBlock x:Name="AgentErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="PauseResume_Click" Content="暂停 / 恢复" />
                                <Button Click="RetryConnection_Click" Content="重试连接" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                        <StackPanel Spacing="8">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="诊断" />
                            <TextBlock Text="统计只在点击刷新时查询；页面不会每秒轮询。" />
                            <Button HorizontalAlignment="Left" Click="RefreshStats_Click" Content="刷新诊断" />
                            <TextBlock x:Name="StatsText" FontFamily="Consolas" Text="尚未查询" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <InfoBar IsClosable="False" IsOpen="True" Message="当前协议没有配置恢复 API。若显示 recovery_required，请重启 Agent 并重新读取正式配置；此页面不会假装恢复成功。" Severity="Warning" Title="配置恢复边界" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Grid.Row="3" Visibility="Collapsed">
                <StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="14">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="关于 InputFlow" />
                    <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
                    <TextBlock Text="支持范围：key_chord、key_mouse_button、hold、hold_mouse_button 触发器，以及 key_chord 动作。录制一次只观察一个键或鼠标按钮。" TextWrapping="Wrap" />
                    <TextBlock Text="当前 x64 设置程序为 unpackaged + framework-dependent，需要 .NET Desktop Runtime 10 和 Windows App Runtime 2.5。关闭此窗口不会停止 Rust Agent、Hook 或托盘。" TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚不支持：鼠标方向、Fn、任意三键、按应用生效、打开程序/文件夹/网页、登录启动和系统辅助功能开关。" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
