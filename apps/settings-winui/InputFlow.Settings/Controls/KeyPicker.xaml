<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="InputFlow_Settings.Controls.KeyPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="LogicalKeyCombo"
                AutomationProperties.Name="逻辑键"
                DisplayMemberPath="Label"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind Options}"
                SelectionChanged="LogicalKeyCombo_SelectionChanged" />
            <Button
                x:Name="CaptureButton"
                Grid.Column="1"
                AutomationProperties.Name="录制这个键"
                Click="CaptureButton_Click"
                Content="录制" />
        </Grid>
        <Expander Header="高级键身份">
            <StackPanel Padding="0,6,0,0" Spacing="8">
                <ToggleSwitch
                    x:Name="PhysicalMode"
                    AutomationProperties.Name="使用物理扫描码"
                    Header="按物理位置匹配"
                    OffContent="Logical"
                    OnContent="Physical"
                    Toggled="PhysicalMode_Toggled" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Name="ScanCodeBox"
                        AutomationProperties.Name="扫描码"
                        Header="Scan code"
                        IsEnabled="False"
                        Maximum="65535"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="1" />
                    <CheckBox
                        x:Name="ExtendedCheck"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="扩展键标志"
                        Content="Extended"
                        IsEnabled="False" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="物理模式跟随键盘位置；仅在非零 scan 可用。显示文字不会写入配置。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Expander>
        <TextBlock
            x:Name="IdentityText"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
